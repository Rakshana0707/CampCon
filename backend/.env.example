# Backend Environment Variables

# The port the Express application will run on (default 5000)
PORT=5000

# The connection string for MySQL database (Prisma Format)
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# The secret key used to sign JSON Web Tokens
JWT_SECRET="your_secure_random_jwt_secret_here"

# Token expiration time (e.g. 7d, 24h)
JWT_EXPIRES_IN="7d"

# Rate Limit Configuration
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# The deployed frontend origin URL to strictly allow via CORS
FRONTEND_URL="https://your-vercel-domain.vercel.app"
