datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------
// ENUMS
// ------------------------------------
enum Role {
  STUDENT
  ORGANIZER
  ADMIN
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  PRESENT
}

enum CertificateType {
  NONE
  PARTICIPATION
  VOLUNTEER
  WINNER
}

enum EventRole {
  PARTICIPANT
  VOLUNTEER
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventType {
  INTRA_COLLEGE
  INTER_COLLEGE
}

enum EventFormat {
  REGULAR
  SYMPOSIUM
}

enum OrganizerType {
  DEPARTMENT
  CLUB
}

enum AffiliationStatus {
  INTERNAL_VERIFIED
  EXTERNAL
  UNVERIFIED
}

enum InstitutionStatus {
  APPROVED
  PENDING_VERIFICATION
  REJECTED
}

// ------------------------------------
// MODELS
// ------------------------------------

model District {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  state     String   @default("Tamil Nadu")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, isActive])
}

model Institution {
  id                Int               @id @default(autoincrement())
  name              String
  code              String?           @unique // AISHE or AICTE identifier e.g. "1-44643113703" or "TN-CBE-CIT"
  state             String            @default("Tamil Nadu")
  district          String
  institutionType   String?           @default("Engineering & Technology")
  address           String?           @db.Text
  university        String?
  sourceDataset     String?           @default("AICTE_TAMIL_NADU_2024")
  sourceRecordId    String?
  isActive          Boolean           @default(true)
  status            InstitutionStatus @default(APPROVED)
  isVerifiedSample  Boolean           @default(false)
  requestedByEmail  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  users                 User[]
  registrations         Registration[]
  activityRegistrations ActivityRegistration[]

  @@unique([name, district, state])
  @@index([state, district])
  @@index([isActive, status])
  @@index([sourceDataset])
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(STUDENT)
  department    String?
  rollNumber    String?
  collegeName       String?           @default("Coimbatore Institute of Technology")
  collegeState      String?           @default("Tamil Nadu")
  collegeDistrict   String?           @default("Coimbatore")
  institutionId     Int?
  affiliationStatus AffiliationStatus @default(UNVERIFIED)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  institution           Institution?          @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  // Relationships
  eventsOrganized       Event[]               @relation("OrganizedEvents")
  organizerAssignments OrganizerAssignment[]
  registrations         Registration[]
  activityRegistrations ActivityRegistration[]
  bookmarks             Bookmark[]
  notifications         Notification[]
  scannedTickets        Attendance[]
  certificates          Certificate[]

  @@index([role])
  @@index([affiliationStatus])
  @@index([isActive])
  @@index([institutionId])
}

model OrganizerEntity {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  type          OrganizerType
  category      String?       // "Undergraduate", "Postgraduate", "Integrated", "Club", "Cell", etc.
  description   String?       @db.Text
  contactPerson String?
  contactEmail  String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relationships
  events        Event[]
  assignments   OrganizerAssignment[]

  @@index([type])
  @@index([isActive])
}

model OrganizerAssignment {
  id                Int             @id @default(autoincrement())
  userId            Int
  organizerEntityId Int
  assignedAt        DateTime        @default(now())

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizerEntity   OrganizerEntity @relation(fields: [organizerEntityId], references: [id], onDelete: Cascade)

  @@unique([userId, organizerEntityId])
  @@index([userId])
  @@index([organizerEntityId])
}

model Event {
  id                           Int             @id @default(autoincrement())
  title                        String
  description                  String          @db.Text
  category                     String
  department                   String
  date                         DateTime        // Start date and time
  endDate                      DateTime?       // End date and time
  expiresAt                    DateTime?       // Expiration timestamp: 24h after endDate (or date)
  venue                        String
  totalSeats                   Int
  availableSeats               Int
  image                        String?         @db.Text
  status                       EventStatus     @default(APPROVED)
  isTrending                   Boolean         @default(false)
  requiresApproval             Boolean         @default(false)
  deadline                     DateTime?       // Registration closing deadline
  
  // Independent Registration Opening Dates
  internalRegOpensAt           DateTime?       // When internal student registration opens
  externalRegOpensAt           DateTime?       // When external college student registration opens

  // Demo / Seed distinction
  isDemo                       Boolean         @default(false)
  
  // Event Classification & Format
  eventType                    EventType       @default(INTRA_COLLEGE)
  eventFormat                  EventFormat     @default(REGULAR)
  numberOfDays                 Int?            @default(1)
  externalParticipationAllowed Boolean         @default(false)
  eligibleParticipants         String?         // Description of eligibility requirements
  contactPerson                String?
  contactEmail                 String?
  
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt

  organizerId                  Int
  organizer                    User            @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: Cascade)

  // Official Organizing Entity
  organizerEntityId            Int?
  organizerEntity              OrganizerEntity? @relation(fields: [organizerEntityId], references: [id], onDelete: SetNull)

  // Relationships
  registrations                Registration[]
  activities                   SymposiumActivity[]
  bookmarks                    Bookmark[]
  attendances                  Attendance[]
  certificates                 Certificate[]

  // Indexes for high-performance filtering
  @@index([status])
  @@index([category])
  @@index([department])
  @@index([date])
  @@index([eventType])
  @@index([eventFormat])
  @@index([organizerEntityId])
}

model Registration {
  id                  Int                @id @default(autoincrement())
  ticketId            String             @unique @default(uuid())
  role                EventRole          @default(PARTICIPANT)
  status              RegistrationStatus @default(PENDING)
  attendance          AttendanceStatus   @default(PENDING)
  certificateType     CertificateType    @default(NONE)
  
  // External participant details for Inter-College Events
  participantCollege  String?
  participantState    String?
  participantDistrict String?
  institutionId       Int?
  institutionDetails  String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  userId              Int
  eventId             Int

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event               Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  institution         Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  attendanceLog       Attendance?
  certificate         Certificate?

  // A user can only register once per event
  @@unique([userId, eventId])
  
  // High-performance lookup indexes
  @@index([userId])
  @@index([eventId])
  @@index([institutionId])
}

model Bookmark {
  userId  Int
  eventId Int

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Composite Primary Key
  @@id([userId, eventId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // If userId is null, it acts as a global broadcast
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attendance {
  id             Int          @id @default(autoincrement())
  registrationId Int          @unique
  eventId        Int
  scannedById    Int
  scannedAt      DateTime     @default(now())

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scannedBy      User         @relation(fields: [scannedById], references: [id])
  
  @@index([eventId])
  @@index([scannedById])
}

model Certificate {
  id             Int          @id @default(autoincrement())
  certificateId  String       @unique @default(uuid())
  registrationId Int          @unique
  userId         Int
  eventId        Int
  issuedAt       DateTime     @default(now())

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
}

model SymposiumActivity {
  id                            Int                    @id @default(autoincrement())
  eventId                       Int                    // Parent symposium
  name                          String
  description                   String?                @db.Text
  category                      String                 @default("Technical") // e.g. Technical paper, Coding, Quiz, Cultural, Gaming, Workshop
  dayNumber                     Int                    @default(1)
  startTime                     DateTime
  endTime                       DateTime
  venue                         String
  maxParticipants               Int
  availableSeats                Int
  
  // Registration and Prerequisites
  requiresSeparateRegistration  Boolean                @default(true)
  requiresOverallRegistration   Boolean                @default(true) // Must have overall symposium registration
  regOpensAt                    DateTime?
  regClosesAt                   DateTime?
  eligibilityRules              String?
  fee                           Float                  @default(0.0) // 0 for free
  orderIndex                    Int                    @default(0)
  isActive                      Boolean                @default(true) // For cancellation/archival

  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt

  event                         Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations                 ActivityRegistration[]

  @@index([eventId])
  @@index([startTime])
  @@index([venue])
}

model ActivityRegistration {
  id                  Int                @id @default(autoincrement())
  ticketId            String             @unique @default(uuid())
  activityId          Int
  userId              Int
  status              RegistrationStatus @default(APPROVED)
  attendance          AttendanceStatus   @default(PENDING)
  participantCollege  String?
  participantState    String?
  participantDistrict String?
  institutionId       Int?
  institutionDetails  String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  activity            SymposiumActivity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution         Institution?       @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@unique([userId, activityId])
  @@index([userId])
  @@index([activityId])
  @@index([institutionId])
}
